  MOV $0xA0000,%EBX
  MOV %EBX,[FBBASE]
  MOV $80,%EBX
  MOV %EBX,[FBW]
  MOV $25,%EBX
  MOV %EBX,[FBH]
  XOR %EAX,%EAX
  MOV $1000,%ECX
