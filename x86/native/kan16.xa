  MOV [G+EAX*8],%ECX
  MOV [G+4+EAX*8],%EDX
  BSWAP %ECX
  BSWAP %EDX
  MOV %EDX,[G+EAX*8]
  MOV %ECX,[G+4+EAX*8]
  JMP @loop
h_putc:
  MOV [R+EBP],%EBX
  MOV %BL,[OB]
  CALL @out1
  JMP @loop
out1:
  MOV $0x3FD,%EDX
oL1:
  IN %DX,%AL
  TEST $0x20,%AL
  JZ @oL1
  MOV $0x3F8,%EDX
  MOVZXB [OB],%EAX
