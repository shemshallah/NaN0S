; NANNET direct-API gate: link state, bounds, address/route/DNS operations and
; longest-prefix route lookup without the config parser.
main:
MOVI r13,1
; initial interface state
MOVI r1,0
CALL @nn_if_find
CMP r5,r0
JMP[EQ] @fail
LD r8,r5,3
MOVI r9,1
CMP r8,r9
JMP[NE] @fail
MOVI r1,1
CALL @nn_if_find
LD r8,r5,3
CMP r8,r0
JMP[NE] @fail
; lo down then up, eth0 up
MOVI r1,0
CALL @nn_link_down
MOVI r1,0
CALL @nn_if_find
LD r8,r5,3
CMP r8,r0
JMP[NE] @fail
MOVI r1,0
CALL @nn_link_up
MOVI r1,1
CALL @nn_link_up
MOVI r1,1
CALL @nn_if_find
LD r8,r5,3
MOVI r9,1
CMP r8,r9
JMP[NE] @fail
; unknown interface -> ENOENT
MOVI r1,9
CALL @nn_link_up
MOVI r8,2
CMP r3,r8
JMP[NE] @fail
; address bounds: prefix 17, ip 0
MOVI r1,1
MOVI r2,0x0A00
MOVI r3,17
CALL @nn_addr_add
MOVI r8,1
CMP r3,r8
JMP[NE] @fail
MOVI r1,1
MOVI r2,0
MOVI r3,16
CALL @nn_addr_add
MOVI r8,1
CMP r3,r8
JMP[NE] @fail
; route bounds: prefix 17
MOVI r1,0
MOVI r2,17
MOVI r3,1
MOVI r4,1
MOVI r5,1
CALL @nn_route_add
MOVI r8,1
CMP r3,r8
JMP[NE] @fail
; empty lookup -> ENOENT
MOVI r1,0x1234
CALL @nn_route_lookup
MOVI r8,2
CMP r3,r8
JMP[NE] @fail
; address add/list/del
MOVI r1,1
MOVI r2,0x0A00
MOVI r3,16
CALL @nn_addr_add
CMP r3,r0
JMP[NE] @fail
CALL @nn_addr_list
MOVI r1,1
MOVI r2,0x0A00
CALL @nn_addr_del
CMP r3,r0
JMP[NE] @fail
CALL @nn_addr_list
; default + /8 routes; longest prefix wins
MOVI r1,0
MOVI r2,0
MOVI r3,1
MOVI r4,1
MOVI r5,1
CALL @nn_route_add
CMP r3,r0
JMP[NE] @fail
MOVI r1,0x0A00
MOVI r2,8
MOVI r3,0x0A01
MOVI r4,1
MOVI r5,1
CALL @nn_route_add
CMP r3,r0
JMP[NE] @fail
MOVI r1,0x0A55
CALL @nn_route_lookup
CMP r3,r0
JMP[NE] @fail
MOVI r8,0x0A01
CMP r1,r8
JMP[NE] @fail
CALL @nn_route_list
MOVI r1,0x0A00
MOVI r2,8
CALL @nn_route_del
CMP r3,r0
JMP[NE] @fail
MOVI r1,0x0A55
CALL @nn_route_lookup
CMP r3,r0
JMP[NE] @fail
MOVI r8,1
CMP r1,r8
JMP[NE] @fail
MOVI r1,0
MOVI r2,0
CALL @nn_route_del
CMP r3,r0
JMP[NE] @fail
MOVI r1,0x0A55
CALL @nn_route_lookup
MOVI r8,2
CMP r3,r8
JMP[NE] @fail
; DNS: two fit, third is ENOSPC
MOVI r1,0x0A01
CALL @nn_dns_add
CMP r3,r0
JMP[NE] @fail
MOVI r1,0x0A02
CALL @nn_dns_add
CMP r3,r0
JMP[NE] @fail
MOVI r1,0x0A03
CALL @nn_dns_add
MOVI r8,3
CMP r3,r8
JMP[NE] @fail
CALL @nn_dns_list
; PASS
MOVI r1,76
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,78
PUTC r1
MOVI r1,75
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,13
PUTC r1
MOVI r1,10
PUTC r1
HALT
fail:
MOVI r1,76
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,78
PUTC r1
MOVI r1,75
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,70
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,13
PUTC r1
MOVI r1,10
PUTC r1
HALT

.include "nannet.nas"
