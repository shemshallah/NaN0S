; NaN16 network frame, CRC32, replay and point-route gate.
main:
MOVI r13,1
CALL @nn_tables_reset
MOVI r1,1
CALL @nn_link_up
MOVI r1,0xA000
MOVI r2,8
MOVI r3,0xA0FF
MOVI r4,1
MOVI r5,1
CALL @nn_route_add
CMP r3,r0
JMP[NE] @fail
MOVI r1,0
MOVHI r1,2
MOVI r2,38
CALL @n16_frame_route
CMP r3,r0
JMP[NE] @fail
BOOL.14 r6,r1,r0
BOOL.14 r7,r2,r0
BOOL.14 r8,r4,r0
MOVI r5,0xA0FF
CMP r6,r5
JMP[NE] @fail
MOVI r5,1
CMP r7,r5
JMP[NE] @fail
MOVI r5,0xA002
CMP r8,r5
JMP[NE] @fail
; The same sequence number must be rejected as a replay.
MOVI r1,0
MOVHI r1,2
MOVI r2,38
CALL @n16_frame_validate
MOVI r5,3
CMP r3,r5
JMP[NE] @fail
; A valid frame with a different 128-bit session id must not enter
; the currently owned session, even with a fresh sequence number.
MOVI r1,0
MOVHI r1,2
ADDI r1,r1,1024
MOVI r2,38
CALL @n16_frame_validate
MOVI r5,5
CMP r3,r5
JMP[NE] @fail

; Stateful N16T transitions and message-specific payload lengths.
MOVI r1,13
MOVI r2,0
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r1,4
MOVI r2,16
CALL @n16_session_transition
MOVI r5,1
CMP r3,r5
JMP[NE] @fail
MOVI r1,1
MOVI r2,2
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r1,83
PUTC r1
MOVI r1,10
PUTC r1
PUTC r1
MOVI r10,32
PUTC r10
PUTC r2
MOVI r10,10
PUTC r10
ADDI r1,r1,48
PUTC r1
SUBI r1,r1,48
MOVI r10,32
PUTC r10
ADDI r2,r2,48
PUTC r2
SUBI r2,r2,48
MOVI r10,10
PUTC r10
MOVI r5,1
CMP r1,r5
JMP[NE] @fail
MOVI r1,2
MOVI r2,8
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r5,2
CMP r1,r5
JMP[NE] @fail
MOVI r1,3
MOVI r2,12
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r5,3
CMP r1,r5
JMP[NE] @fail
MOVI r1,4
MOVI r2,4096
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r1,5
MOVI r2,4
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r1,6
MOVI r2,4
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r5,5
CMP r1,r5
JMP[NE] @fail
MOVI r1,9
MOVI r2,4
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r5,6
CMP r1,r5
JMP[NE] @fail
MOVI r1,10
MOVI r2,8
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r5,7
CMP r1,r5
JMP[NE] @fail
MOVI r1,11
MOVI r2,4
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r5,8
CMP r1,r5
JMP[NE] @fail
MOVI r1,13
MOVI r2,0
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
CMP r1,r0
JMP[NE] @fail
MOVI r1,1
MOVI r2,3
CALL @n16_session_transition
MOVI r5,2
CMP r2,r5
JMP[NE] @fail
CMP r1,r0
JMP[NE] @fail

; Guest encoder must emit a CRC-valid N16T frame with the expected type and length.
MOVI r1,4928
MOVHI r1,2
MOVI r2,1
MOVI r3,2
MOVI r4,12992
MOVHI r4,2
MOVI r5,2
MOVI r6,12928
MOVHI r6,2
CALL @n16_frame_build
MOVI r10,66
PUTC r10
MOVI r10,10
PUTC r10
MOVI r5,38
CMP r1,r5
JMP[NE] @fail
MOVI r10,76
PUTC r10
MOVI r10,10
PUTC r10
MOVI r1,4928
MOVHI r1,2
MOVI r2,38
CALL @n16_frame_validate
MOVI r10,86
PUTC r10
MOVI r10,10
PUTC r10
CMP r3,r0
JMP[NE] @fail
MOVI r5,1
CMP r1,r5
JMP[NE] @fail
MOVI r10,84
PUTC r10
MOVI r10,10
PUTC r10
MOVI r5,2
CMP r2,r5
JMP[NE] @fail
MOVI r10,78
PUTC r10
MOVI r10,10
PUTC r10
MOVI r1,13
MOVI r2,0
CALL @n16_session_transition
CMP r3,r0
JMP[NE] @fail
MOVI r10,67
PUTC r10
MOVI r10,10
PUTC r10
; pass
MOVI r1,78
PUTC r1
MOVI r1,49
PUTC r1
MOVI r1,54
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,67
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,10
PUTC r1
HALT
fail:
MOVI r1,78
PUTC r1
MOVI r1,49
PUTC r1
MOVI r1,54
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,67
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,70
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,10
PUTC r1
HALT
.include "nannet.nas"
.include "overbootstrap_route.nas"
.include "train_protocol.nas"
.org 32768
frame:
.word 0x5436314E,0x00010001,0,0,0,0,1,2,0xF5B70002,0x00006DAD

.org 33024
other_session_frame:
.word 0x5436314E,0x00010001,0x00000001,0,0,0,2,2,0xE8230002,0x00006187

.org 36000
builder_session_id:
.word 0x12345678,0x90ABCDEF,0x13579BDF,0x2468ACE0
builder_payload:
.word 0x00000002
