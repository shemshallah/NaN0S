; NaN16 network frame, CRC32, replay and point-route gate.
main:
MOVI r13,1
CALL @nn_tables_reset
MOVI r1,1
CALL @nn_link_up
MOVI r1,0xA000
MOVI r2,8
MOVI r3,0xA0FF
MOVI r4,1
MOVI r5,1
CALL @nn_route_add
CMP r3,r0
JMP[NE] @fail
MOVI r1,0
MOVHI r1,2
MOVI r2,38
CALL @n16_frame_route
CMP r3,r0
JMP[NE] @fail
BOOL.14 r6,r1,r0
BOOL.14 r7,r2,r0
BOOL.14 r8,r4,r0
MOVI r5,0xA0FF
CMP r6,r5
JMP[NE] @fail
MOVI r5,1
CMP r7,r5
JMP[NE] @fail
MOVI r5,0xA002
CMP r8,r5
JMP[NE] @fail
; The same sequence number must be rejected as a replay.
MOVI r1,0
MOVHI r1,2
MOVI r2,38
CALL @n16_frame_validate
MOVI r5,3
CMP r3,r5
JMP[NE] @fail
; A valid frame with a different 128-bit session id must not enter
; the currently owned session, even with a fresh sequence number.
MOVI r1,0
MOVHI r1,2
ADDI r1,r1,256
MOVI r2,38
CALL @n16_frame_validate
ADDI r1,r3,48
PUTC r1
MOVI r5,5
CMP r3,r5
JMP[NE] @fail
; pass
MOVI r1,78
PUTC r1
MOVI r1,49
PUTC r1
MOVI r1,54
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,67
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,10
PUTC r1
HALT
fail:
MOVI r1,78
PUTC r1
MOVI r1,49
PUTC r1
MOVI r1,54
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,67
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,70
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,10
PUTC r1
HALT
.include "nannet.nas"
.include "overbootstrap_route.nas"
.include "train_protocol.nas"
.org 32768
frame:
.word 0x5436314E,0x00010001,0,0,0,0,1,2,0xF5B70002,0x00006DAD

