; Overbootstrap point and NaNNET route bridge gate.
main:
MOVI r13,1
; point #1 is page 0 / runner CPU ring
MOVI r1,1
CALL @ob_point_to_page
CMP r1,r0
JMP[NE] @fail
MOVI r4,1
CMP r2,r4
JMP[NE] @fail
CMP r3,r0
JMP[NE] @fail
MOVI r1,65
PUTC r1
; point #2 is page 1 / Android test universe
MOVI r1,2
CALL @ob_point_to_page
MOVI r4,1
CMP r1,r4
JMP[NE] @fail
MOVI r4,2
CMP r2,r4
JMP[NE] @fail
MOVI r1,66
PUTC r1
; point #2 offset maps to page 1 + byte offset
MOVI r1,2
MOVI r2,1234
MOVI r3,100
CALL @ob_point_to_addr
MOVI r4,0x04D2
MOVHI r4,0x0080
CMP r1,r4
JMP[NE] @fail
MOVI r4,1
CMP r2,r4
JMP[NE] @fail
CMP r3,r0
JMP[NE] @fail
MOVI r1,67
PUTC r1
; point #256 maps to page 255
MOVI r1,256
CALL @ob_point_to_page
MOVI r4,255
CMP r1,r4
JMP[NE] @fail
MOVI r1,68
PUTC r1
; reject page-crossing range
MOVI r1,2
MOVI r2,0xFFF8
MOVHI r2,127
MOVI r3,16
CALL @ob_point_to_addr
MOVI r4,1
CMP r3,r4
JMP[NE] @fail
; reject point 257
MOVI r1,257
CALL @ob_point_to_page
MOVI r4,1
CMP r3,r4
JMP[NE] @fail
MOVI r1,69
PUTC r1
; connect the point translator to the existing NaNNET route table
CALL @nn_tables_reset
MOVI r1,1
CALL @nn_link_up
MOVI r1,0xA000
MOVI r2,8
MOVI r3,0xA0FF
MOVI r4,1
MOVI r5,1
CALL @nn_route_add
CMP r3,r0
JMP[NE] @fail
MOVI r1,70
PUTC r1
MOVI r1,2
CALL @ob_point_to_route
CMP r3,r0
JMP[NE] @fail
MOVI r1,71
PUTC r1
BOOL.14 r6,r1,r0
MOVI r1,32
PUTC r1
BOOL.14 r1,r6,r0
CALL @nn_puthex4
MOVI r1,32
PUTC r1
BOOL.14 r1,r6,r0
MOVI r4,0xA0FF
CMP r1,r4
JMP[NE] @fail
MOVI r4,1
CMP r2,r4
JMP[NE] @fail
MOVI r5,0xA002
CMP r4,r5
JMP[NE] @fail
; pass
MOVI r1,79
PUTC r1
MOVI r1,86
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,66
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,10
PUTC r1
HALT
fail:
MOVI r1,79
PUTC r1
MOVI r1,86
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,66
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,70
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,10
PUTC r1
HALT
.include "nannet.nas"
