; End-to-end guest slice: task claim -> typed math resolution -> completion.
main:
MOVI r13,1
; Register vector1337 and hypergraph42 in the mathematical object table.
MOVI r1,1337
MOVI r2,4
MOVI r3,1
MOVI r4,4660
CALL @nmr_obj_put
CMP r3,r0
JMP[NE] @fail
MOVI r1,42
MOVI r2,8
MOVI r3,1
MOVI r4,22136
CALL @nmr_obj_put
CMP r3,r0
JMP[NE] @fail
; Register vector(4) x hypergraph(8) -> tensor(9), program 900.
MOVI r1,77
MOVI r2,4
MOVI r3,8
MOVI r4,9
MOVI r5,900
CALL @nmr_op_put
CMP r3,r0
JMP[NE] @fail
; Queue the router task for HW0 logical point 1.
MOVI r1,8001
MOVI r2,9
MOVI r3,111
MOVI r4,1
MOVI r5,1
MOVI r6,77
MOVI r7,222
MOVI r8,64
MOVI r9,1000
MOVI r10,500
MOVI r11,12
CALL @nmr_task_submit
CMP r3,r0
JMP[NE] @fail
; Claim at epoch 10, inside the [9,12] issue/expiry window.
MOVI r1,8001
MOVI r2,1
MOVI r3,10
CALL @nmr_task_claim
CMP r3,r0
JMP[NE] @fail
; Resolve the two typed endpoints through the operator registry.
MOVI r1,1337
MOVI r2,42
MOVI r3,77
CALL @nmr_resolve
CMP r3,r0
JMP[NE] @fail
MOVI r5,9
CMP r1,r5
JMP[NE] @fail
MOVI r5,900
CMP r2,r5
JMP[NE] @fail
; Complete the task with deterministic output and trace digest markers.
MOVI r1,8001
MOVI r2,1
MOVI r3,10
MOVI r4,333
MOVI r5,444
CALL @nmr_task_finish
CMP r3,r0
JMP[NE] @fail
; pass
MOVI r1,82
PUTC r1
MOVI r1,85
PUTC r1
MOVI r1,78
PUTC r1
MOVI r1,78
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,78
PUTC r1
MOVI r1,71
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,10
PUTC r1
HALT
