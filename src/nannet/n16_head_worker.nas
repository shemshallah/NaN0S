; Standalone, host-callable native NaN16 scratch learning worker.
; This image contains ONLY native guest head validation and observation code.
; The host must import/export RAW 8-byte words; the existing nan_write_bytes
; endpoint rewrites NaN faces and is not acceptable for this state.
;
; External host entry labels (generated by nmk.awk -v LABELS=...):
;   nh_format, nh_open, nhr_attach, nhr_detach, nhr_read, nhr_observe
; Guest word layout/contract:
;   bank base 0x4000, NH_WORDS=67838 raw words -> ~530 KiB
;   staging base 0x1000, 128 raw NaN16 words
;   readback base 0x2000, 128 raw NaN16 words
; These regions do not overlap. The guest will validate nonaliased staging.
; Head 0 is NANNET0: never train it.
; Reserved ABI registers r0=0, r13=1, host call r15=0 -> RET to PC0 HALT.
; One guest VM per attached operation; never concurrent or network-unauthenticated.
.org 0
JMP @n16_head_worker_idle
.include "n16_head_store.nas"
.include "n16_head_runtime.nas"
n16_head_worker_idle:
  HALT
