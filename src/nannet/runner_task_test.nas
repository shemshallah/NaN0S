; NaNLMROUTER task ledger: enqueue, ownership, epoch, claim and replay gates.
main:
MOVI r13,1
; Submit task 7001 for runner 1, epoch 9, logical point 1.
MOVI r1,7001
MOVI r2,9
MOVI r3,111
MOVI r4,1
MOVI r5,1
MOVI r6,77
MOVI r7,222
MOVI r8,64
MOVI r9,1000
MOVI r10,500
MOVI r11,12
CALL @nmr_task_submit
CMP r3,r0
JMP[NE] @fail
; Duplicate task id must be rejected.
MOVI r1,7001
MOVI r2,9
MOVI r3,111
MOVI r4,1
MOVI r5,1
MOVI r6,77
MOVI r7,222
MOVI r8,64
MOVI r9,1000
MOVI r10,500
MOVI r11,12
CALL @nmr_task_submit
MOVI r5,5
CMP r3,r5
JMP[NE] @fail
; Reserved logical point 0 must be rejected.
MOVI r1,7002
MOVI r2,9
MOVI r3,111
MOVI r4,1
MOVI r5,0
MOVI r6,77
MOVI r7,222
MOVI r8,64
MOVI r9,1000
MOVI r10,500
MOVI r11,12
CALL @nmr_task_submit
MOVI r5,1
CMP r3,r5
JMP[NE] @fail
; Wrong runner cannot claim the task.
MOVI r1,7001
MOVI r2,2
MOVI r3,9
CALL @nmr_task_claim
MOVI r5,6
CMP r3,r5
JMP[NE] @fail
; Wrong epoch cannot claim the task.
MOVI r1,7001
MOVI r2,1
MOVI r3,10
CALL @nmr_task_claim
MOVI r5,6
CMP r3,r5
JMP[NE] @fail
; Correct owner and epoch claim exactly once.
MOVI r1,7001
MOVI r2,1
MOVI r3,9
CALL @nmr_task_claim
CMP r3,r0
JMP[NE] @fail
MOVI r1,7001
MOVI r2,1
MOVI r3,9
CALL @nmr_task_claim
MOVI r5,7
CMP r3,r5
JMP[NE] @fail
; Finish with output and trace digests.
MOVI r1,7001
MOVI r2,1
MOVI r3,9
MOVI r4,333
MOVI r5,444
CALL @nmr_task_finish
CMP r3,r0
JMP[NE] @fail
; Duplicate completion is rejected.
MOVI r1,7001
MOVI r2,1
MOVI r3,9
MOVI r4,333
MOVI r5,444
CALL @nmr_task_finish
MOVI r5,7
CMP r3,r5
JMP[NE] @fail
; pass
MOVI r1,82
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,85
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,75
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,10
PUTC r1
HALT
fail:
MOVI r1,82
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,85
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,84
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,75
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,70
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,10
PUTC r1
HALT
.include "runner_task.nas"
