; ---- key loop
key_l:
KEY r1
MOVI r4,0xFF
BOOL.8 r1,r1,r4
CMP r1,r0
JMP[EQ] @key_l
MOVI r4,27
CMP r1,r4
JMP[EQ] @exit
MOVI r4,113
CMP r1,r4
JMP[EQ] @exit
MOVI r4,55
CMP r1,r4
JMP[EQ] @exit
MOVI r4,49
CMP r1,r4
JMP[EQ] @scan
JMP @key_l
; ---- device scan (PCI classes), result line at row 12
scan:
MOVI r10,3320
MOVI r6,0
MOVI r11,0
sc_l:
MOVI r1,0
MOVHI r1,32768
SHL r7,r6,11
BOOL.14 r9,r1,r7
OUTL r9,r10
MOVI r2,3324
INW r3,r2
MOVI r4,65535
CMP r3,r4
JMP[EQ] @sc_s
MOVI r2,8
BOOL.14 r8,r9,r2
OUTL r8,r10
MOVI r2,3326
INW r7,r2
ADDI r8,r7,0
SHR r8,r8,8
MOVI r2,2
CMP r8,r2
JMP[NE] @sc_s
ADDI r11,r11,1
sc_s:
ADDI r6,r6,1
MOVI r2,32
CMP r6,r2
JMP[LT] @sc_l
