  SUB r3,r9,r11
  SUB r8,r8,r10
  SUB r8,r8,r4
  ST r8,r1,0
  ST r3,r1,1
  RET

; ---- xorv: [r1] pair ^= (r2=hi, r3=lo)
xorv:
  LD r4,r1,0
  LD r5,r1,1
