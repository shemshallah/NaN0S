  ADDI[LT] r4,r4,1
  ADD r8,r8,r10
  ADD r8,r8,r4
  ST r8,r1,0
  ST r3,r1,1
  RET

; ---- subm: [r1] pair -= [r2] pair (borrow from cmp of originals)
subm:
  LD r8,r1,0
  LD r9,r1,1
  LD r10,r2,0
  LD r11,r2,1
  CMP r9,r11
