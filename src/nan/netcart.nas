; ---- addm: [r1] pair += [r2] pair (carry exact: result<a_lo cmp)
addm:
  LD r8,r1,0
  LD r9,r1,1
  LD r10,r2,0
  LD r11,r2,1
  ADD r3,r9,r11
  CMP r3,r9
  MOVI r4,0
  ADDI[LT] r4,r4,1
  ADD r8,r8,r10
  ADD r8,r8,r4
  ST r8,r1,0
  ST r3,r1,1
  RET

; ---- subm: [r1] pair -= [r2] pair (borrow from cmp of originals)
subm:
  LD r8,r1,0
  LD r9,r1,1
  LD r10,r2,0
  LD r11,r2,1
  CMP r9,r11
  MOVI r4,0
  ADDI[LT] r4,r4,1
  SUB r3,r9,r11
  SUB r8,r8,r10
  SUB r8,r8,r4
  ST r8,r1,0
  ST r3,r1,1
  RET

; ---- xorv: [r1] pair ^= (r2=hi, r3=lo)
xorv:
  LD r4,r1,0
  LD r5,r1,1
  BOOL.6 r4,r4,r2
  BOOL.6 r5,r5,r3
  ST r4,r1,0
  ST r5,r1,1
  RET

; ---- mul64: a=(r8=hi,r9=lo) b=(r10=hi,r11=lo) mod 2^64 -> za pair (hi @za, lo @za+1)
mul64:
  MUL r1,r9,r11
  MULHU r2,r9,r11
  MUL r3,r9,r10
  MUL r5,r8,r11
