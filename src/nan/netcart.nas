; ---- word-list print (space-separated, 32-hex-digit words)
putwordl:
  ST r15,r0,@r_pw
  LD r8,r14,#pwbase
  MOVI r7,0
pw_l:
  LD r3,r14,#pwcnt
  CMP r7,r3
  JMP[GE] @pw_d
  CMP r7,r0
  JMP[EQ] @pw_ns
  MOVI r1,32
  PUTC r1
pw_ns:
  ADD r4,r14,r8
  LD r5,r4,0
  CALL @puthex8
  LD r5,r4,1
  CALL @puthex8
  ADDI r7,r7,1
  ADDI r8,r8,2
  JMP @pw_l
pw_d:
  LD r15,r0,@r_pw
  RET
nl:
  MOVI r1,10
  PUTC r1
  RET
puthex8:
  MOVI r6,8
puthexn:
  ST r15,r0,@phn_ret
phn_l:
  SHR r1,r5,28
  CALL @puthex1
  SHL r5,r5,4
  SUB r6,r6,r13
  CMP r6,r0
  JMP[NE] @phn_l
  LD r15,r0,@phn_ret
  RET
puthex1:
  MOVI r2,10
  CMP r1,r2
  JMP[LT] @phx_d
  ADDI r1,r1,55
  PUTC r1
  RET
phx_d:
  ADDI r1,r1,48
  PUTC r1
  RET

