  SHR r1,r5,28
  CALL @puthex1
  SHL r5,r5,4
  SUB r6,r6,r13
  CMP r6,r0
  JMP[NE] @phn_l
  LD r15,r0,@phn_ret
  RET
puthex1:
  MOVI r2,10
  CMP r1,r2
  JMP[LT] @phx_d
  ADDI r1,r1,55
  PUTC r1
  RET
phx_d:
  ADDI r1,r1,48
  PUTC r1
  RET

