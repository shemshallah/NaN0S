  LD r11,r14,#seedm+1
  CALL @mul64
  ADDI r1,r14,#za
  ADDI r2,r14,#seedm+2
  CALL @addm
  LD r1,r14,#za
  ST r1,r14,#lcg
  LD r1,r14,#za+1
  ST r1,r14,#lcg+1
  LD r15,r0,@r_lg
  RET
fill:
