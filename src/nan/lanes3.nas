; src/nan/lanes3.nas - word-lane engine + self-check cart (org 0).
; 64-bit lane math rebuilt from 32-bit registers per the lane model.
; Neutral plumbing: forward/inverse round steps, wall-clock-free
; self-checks derived from standard mixer studies. Internal docs kept out.

.equ B0 1000000
.equ ST 0
.equ WK 18
.equ rcix 20
.equ za 24
.equ zb 26
.equ zc 28
.equ rn 30
.equ rounds 31
.equ key 40
.equ non 48
.equ ib 64
.equ ia 72
.equ ob 80
.equ oa 88
.equ cb 96
.equ sg 104
.equ lcg 120
.equ seedm 128
.equ seeds 132
.equ pwbase 136
.equ pwcnt 138
.equ tmpb 160
.equ adi 172
.equ pti 174

