; ---- addm: [r1] pair += [r2] pair (carry exact: result<a_lo cmp)
addm:
  LD r8,r1,0
  LD r9,r1,1
  LD r10,r2,0
  LD r11,r2,1
  ADD r3,r9,r11
  CMP r3,r9
  MOVI r4,0
  ADDI[LT] r4,r4,1
  ADD r8,r8,r10
  ADD r8,r8,r4
  ST r8,r1,0
  ST r3,r1,1
  RET

; ---- subm: [r1] pair -= [r2] pair (borrow from cmp of originals)
subm:
  LD r8,r1,0
  LD r9,r1,1
  LD r10,r2,0
  LD r11,r2,1
  CMP r9,r11
  MOVI r4,0
  ADDI[LT] r4,r4,1
  SUB r3,r9,r11
  SUB r8,r8,r10
  SUB r8,r8,r4
  ST r8,r1,0
  ST r3,r1,1
  RET

; ---- xorv: [r1] pair ^= (r2=hi, r3=lo)
xorv:
  LD r4,r1,0
  LD r5,r1,1
  BOOL.6 r4,r4,r2
  BOOL.6 r5,r5,r3
  ST r4,r1,0
  ST r5,r1,1
  RET

; ---- mul64: a=(r8=hi,r9=lo) b=(r10=hi,r11=lo) mod 2^64 -> za pair (hi @za, lo @za+1)
mul64:
  MUL r1,r9,r11
  MULHU r2,r9,r11
  MUL r3,r9,r10
  MUL r5,r8,r11
  ADD r3,r3,r5
  ADD r2,r2,r3
  ST r2,r14,#za
  ST r1,r14,#za+1
  RET

; ---- lcgreset / lcg / fill
lcgreset:
  LD r1,r0,@d_shi
  ST r1,r14,#lcg
  LD r1,r0,@d_slo
  ST r1,r14,#lcg+1
  RET
lcg:
  ST r15,r0,@r_lg
  LD r8,r14,#lcg
  LD r9,r14,#lcg+1
  LD r10,r14,#seedm
  LD r11,r14,#seedm+1
  CALL @mul64
  ADDI r1,r14,#za
  ADDI r2,r14,#seedm+2
  CALL @addm
  LD r1,r14,#za
  ST r1,r14,#lcg
  LD r1,r14,#za+1
  ST r1,r14,#lcg+1
  LD r15,r0,@r_lg
  RET
fill:
  ST r15,r0,@r_fi
  ADDI r6,r2,0
  ADDI r7,r1,0
fi_l:
  CMP r6,r0
  JMP[EQ] @fi_d
  CALL @lcg
  ADD r3,r14,r7
  LD r4,r14,#lcg
  ST r4,r3,0
  LD r4,r14,#lcg+1
  ST r4,r3,1
  ADDI r7,r7,2
  SUB r6,r6,r13
  JMP @fi_l
fi_d:
  LD r15,r0,@r_fi
  RET

; ---- kv: index (r8) -> pair @za
kv:
  ST r15,r0,@r_kv
  MOVI r9,11
  MUL r8,r8,r9
  MOVI r9,90
  ADD r8,r8,r9
  ADDI r9,r8,0
  MOVI r8,0
  MOVI r10,31161
  MOVHI r10,40503
  MOVI r11,31765
  MOVHI r11,32586
  CALL @mul64
  LD r1,r14,#za
  LD r2,r14,#za+1
  MOVI r3,62609
  MOVHI r3,9541
  MOVI r4,56605
  MOVHI r4,20332
  ADDI r5,r2,0
  ADD r2,r2,r4
  CMP r2,r5
  MOVI r5,0
  ADDI[LT] r5,r5,1
  ADD r1,r1,r3
  ADD r1,r1,r5
  ST r1,r14,#za
  ST r2,r14,#za+1
  LD r8,r14,#za
  LD r9,r14,#za+1
  SHR r1,r8,30
  SHL r2,r8,2
  SHR r3,r9,30
  BOOL.14 r3,r3,r2
  BOOL.6 r8,r8,r1
  BOOL.6 r9,r9,r3
  ST r8,r14,#za
  ST r9,r14,#za+1
  LD r2,r14,#za
  LD r1,r14,#za+1
  ADDI r8,r2,0
  ADDI r9,r1,0
  MOVI r10,18285
  MOVHI r10,48984
  MOVI r11,58809
  MOVHI r11,7396
  CALL @mul64
  LD r8,r14,#za
  LD r9,r14,#za+1
  SHR r1,r8,27
  SHL r2,r8,5
  SHR r3,r9,27
  BOOL.14 r3,r3,r2
  BOOL.6 r8,r8,r1
  BOOL.6 r9,r9,r3
  ST r8,r14,#za
  ST r9,r14,#za+1
  LD r2,r14,#za
  LD r1,r14,#za+1
  ADDI r8,r2,0
  ADDI r9,r1,0
  MOVI r10,18875
  MOVHI r10,38096
  MOVI r11,4587
  MOVHI r11,4913
  CALL @mul64
  LD r8,r14,#za
  LD r9,r14,#za+1
  SHR r1,r8,31
  SHL r2,r8,1
  SHR r3,r9,31
  BOOL.14 r3,r3,r2
  BOOL.6 r8,r8,r1
  BOOL.6 r9,r9,r3
  ST r8,r14,#za
  ST r9,r14,#za+1
  LD r15,r0,@r_kv
  RET

; ---- dif (forward rounds)
dif:
  ST r15,r0,@r_dif
  LD r1,r14,#WK
  LD r2,r14,#WK+1
  CMP r2,r0
  JMP[NE] @dif_tg
  MOVI r1,0
  JMP @dif_bs
dif_tg:
  MOVI r2,14
  MUL r1,r1,r2
dif_bs:
  ST r1,r14,#rcix
  MOVI r6,0
dif_loop:
  LD r1,r14,#rcix
  ADD r8,r1,r6
  CALL @kv
  ADDI r1,r14,0
  LD r2,r14,#za
  LD r3,r14,#za+1
  CALL @xorv
  LD r1,r14,#rcix
  ADD r8,r1,r6
  ADDI r8,r8,3
  CALL @kv
  ADDI r1,r14,8
  LD r2,r14,#za
  LD r3,r14,#za+1
