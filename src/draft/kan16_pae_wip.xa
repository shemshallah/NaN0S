; kan16.xa - NaN16/NaNVM1 native core, BARE flat 32-bit x86, assembled by nasm1.
; The ONE host file; everything else is NaN16 guest code. Transcribed from src/native/nan16.s.
.base 0x10000
.code32
.equ MASK 0x3FFFFF
.equ MAXOP 0x45
.equ G 0x200000
.equ R 0x8000
.equ VGA 0xB8000
.equ FB 0xA0000
.equ VMODE 0x8066
.equ FBW 0x8068
.equ FBH 0x806C
.equ FLAGM 0x8040
.equ STEPS 0x8044
.equ MAXS 0x8048
.equ T0 0x804C
.equ KB 0x8050
.equ OB 0x8054
.equ MS 0x8058
.equ MSF 0x805C
.equ SHIFT 0x8060
.equ E0 0x8061
.equ CAPS 0x8062
.equ RHEAD 0x8064
.equ RTAIL 0x8065
.equ KRING 0x8070
.equ FBBASE 0x8090
.equ FBTOT 0x8094
.equ VBEARG 0x8098
.equ RAWKB 0x809C
.equ CPUIDR 0x80B0
.equ IDT 0x9000
.equ MASKV 0x80C0
.equ PAEF 0x80C4
.equ CURB 0x80C8
.equ NFR 0x80CC
.equ NSW 0x80D0
.equ NWD 0x80D4
.equ MAXM 0x80D8
.equ BS 0x80DC
.equ BD 0x80E0
.equ BTOT 0x80E4
.equ BC 0x80E8
.equ BDIR 0x80EC
.equ BN 0x80F0
.equ BO 0x80F4
.equ PDPT 0x40000
.equ PDA 0x41000
.equ FT 0x50000
.equ BOUNCE 0x60000
.equ E8N 0x5FC
.equ E8T 0x600
_start:
  CLD
  MOVL $0x7FFFFFFF,[MAXS]
  MOVL $1,[FLAGM]
  MOVL $0,[STEPS]
  MOVL $0xA0000,[FBBASE]
  MOVL $64000,[FBTOT]
  MOVB $0,[RAWKB]
  MOV $G,%EDI
  XOR %EAX,%EAX
  MOV $0x800000,%ECX
  REPSTOSD
  MOV $0x12000,%ESI
  MOV $G,%EDI
  MOV $0x20000,%ECX
  REPMOVSD
  CALL @hw_init
  CALL @pae_init
  XOR %ESI,%ESI
loop:
  MOV [STEPS],%EAX
  CMP [MAXS],%EAX
  JAE @done
  INC %EAX
  MOV %EAX,[STEPS]
  MOV %ESI,%ECX
  AND [MASKV],%ECX
  CMP $0x8000000,%ECX
  JB @fk0
  CALL @nrmC
fk0:
  CALL @nib
  JC @gate
  INC %ESI
  SHRD $16,%EDX,%EAX
  MOV %EAX,%EBX
  SHR $24,%EBX
  CMP $0xFF,%EBX
  JE @done
  CMP $MAXOP,%EBX
  JA @badop
  MOV %EAX,%EBP
  SHR $18,%EBP
  AND $0x3C,%EBP
  MOV %EAX,%ECX
  SHR $14,%ECX
  AND $0x3C,%ECX
  MOV [R+ECX],%ECX
  MOV %EAX,%EDX
  AND $15,%EDX
  MOV [R+EDX*4],%EDX
  TEST %EBX,%EBX
  JZ @L5
  TEST %EDI,[FLAGM]
  JZ @loop
L5:
  JMP [tbl+EBX*4]
head:
  MOV %EBX,%ECX
  AND $0x7FF0,%ECX
  CMP $0x7FF0,%ECX
  JNE @L8
  MOV $0x01020000,%ECX
  BT %EBX,%ECX
  JNC @L8
  MOV %EBX,%ECX
  SHR $2,%ECX
  AND $2,%ECX
  SHR $15,%EBX
  OR %EBX,%ECX
  CLC
  RET
L8:
  STC
  RET
nib:
  MOV [G+ECX*8],%EAX
  MOV [G+4+ECX*8],%EDX
  MOV %EDX,%EBX
  SHR $16,%EBX
  CALL @head
  JC @L9
  LEA [ECX*4],%EDI
  MOV %EAX,%EBX
  BSWAP %EBX
  SHR $16,%EBX
  CALL @head
  JC @L9
  OR %ECX,%EDI
L9:
  RET
putw:
  MOV %ECX,%EDX
  AND $3,%ECX
  MOVZWL [heads+ECX*2],%ECX
  ROL $8,%CX
  PUSH %EBX
  SHL $16,%EBX
  OR %ECX,%EBX
  MOV %EBX,[G+EAX*8]
  POP %EBX
  SHR $16,%EBX
  SHR $2,%EDX
  MOVZWL [heads+EDX*2],%EDX
  SHL $16,%EDX
  OR %EDX,%EBX
  MOV %EBX,[G+4+EAX*8]
  RET
wrz:
  MOV %EBX,[R+EBP]
  TEST %EBX,%EBX
wf:
  MOV %EBX,[R+EBP]
fl:
  SETC %CL
  SETZ %AL
fl2:
  MOVZX %CL,%ECX
  MOVZX %AL,%EAX
  LEA [ECX+EAX*2],%ECX
  MOV $1,%EAX
  SHL %CL,%EAX
  MOV %EAX,[FLAGM]
  JMP @loop
st:
  MOV %EBX,[R+EBP]
  JMP @loop
stf:
  MOV %EBX,[R+EBP]
  MOVL $1,[FLAGM]
  JMP @loop
h_bool:
  XOR %EBX,%EBX
  MOV %ECX,%EAX
  OR %EDX,%EAX
  NOT %EAX
  TEST $1,%EDI
  JZ @hb1
  OR %EAX,%EBX
hb1:
  MOV %ECX,%EAX
  NOT %EAX
  AND %EDX,%EAX
  TEST $2,%EDI
  JZ @hb2
  OR %EAX,%EBX
hb2:
  MOV %EDX,%EAX
  NOT %EAX
  AND %ECX,%EAX
  TEST $4,%EDI
  JZ @hb3
  OR %EAX,%EBX
hb3:
  MOV %ECX,%EAX
  AND %EDX,%EAX
  TEST $8,%EDI
  JZ @hb4
  OR %EAX,%EBX
hb4:
  JMP @wrz
h_movi:
  MOVZWL %AX,%EBX
  JMP @st
h_movhi:
  MOVZWL [R+EBP],%EBX
  SHL $16,%EAX
  OR %EAX,%EBX
  JMP @st
h_add:
  MOV %ECX,%EBX
  ADD %EDX,%EBX
  JMP @wf
h_sub:
  MOV %ECX,%EBX
  SUB %EDX,%EBX
  JMP @wf
h_shl:
  MOV %ECX,%EBX
  MOV %EAX,%ECX
  SHL %CL,%EBX
