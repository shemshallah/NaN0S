pci_x:
  MOV %EBX,[FBBASE]
  MOV $1,%EBX
  MOV %BL,[VMODE]
  MOV [VBEARG],%EAX
  SHR $16,%EAX
  MOV %EAX,[FBW]
  MOV [VBEARG],%EBX
  AND $0xFFFF,%EBX
  MOV %EBX,[FBH]
  IMUL %EAX,%EBX
  MOV %EBX,[FBTOT]
  MOV %EBX,%ECX
