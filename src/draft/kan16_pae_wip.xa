  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk5
  CALL @nrmA
fk5:
  MOV [G+EAX*8],%ECX
  MOV [G+4+EAX*8],%EDX
  BSWAP %ECX
  BSWAP %EDX
  MOV %EDX,[G+EAX*8]
  MOV %ECX,[G+4+EAX*8]
  JMP @loop
h_putc:
  MOV [R+EBP],%EBX
  MOV %BL,[OB]
  CALL @out1
  JMP @loop
out1:
  MOV $0x3FD,%EDX
oL1:
  IN %DX,%AL
  TEST $0x20,%AL
  JZ @oL1
  MOV $0x3F8,%EDX
  MOVZXB [OB],%EAX
  OUT %AL,%DX
  RET
h_dispq:
  MOVZXB [VMODE],%EAX
  CMP $1,%EAX
  JNE @dq_text
  MOV $0x1300C800,%EBX
  JMP @st
dq_text:
  MOV $0x31950,%EBX
  JMP @st
h_dispset:
  MOV [R+EBP],%EAX
  CMP $0xFFFF0000,%EAX
  JAE @sd_raw
  CMP $0x10000,%EAX
  JAE @sd_vbe
  AND $255,%EAX
  CMP $0x13,%EAX
  JE @sd13
  CALL @vbe_off
  XOR %EBX,%EBX
  MOV %BL,[VMODE]
  MOV $0xA0000,%EBX
  MOV %EBX,[FBBASE]
  MOV $80,%EBX
  MOV %EBX,[FBW]
  MOV $25,%EBX
  MOV %EBX,[FBH]
  XOR %EAX,%EAX
  MOV $1000,%ECX
  MOV $VGA,%EDI
  CLD
  REPSTOSD
  JMP @loop
sd13:
  CALL @vbe_off
  MOV $1,%EBX
  MOV %BL,[VMODE]
  MOV $0xA0000,%EBX
  MOV %EBX,[FBBASE]
  MOV $64000,%EBX
  MOV %EBX,[FBTOT]
  MOV $320,%EBX
  MOV %EBX,[FBW]
  MOV $200,%EBX
  MOV %EBX,[FBH]
  XOR %EAX,%EAX
  MOV $16000,%ECX
  MOV $FB,%EDI
  CLD
  REPSTOSD
  JMP @loop
sd_raw:
  MOVZXB %AL,%EAX
  MOV %AL,[RAWKB]
  MOVB $0,[RHEAD]
  MOVB $0,[RTAIL]
  JMP @loop
sd_vbe:
  MOV %EAX,[VBEARG]
  MOV $4,%EBX
  XOR %EAX,%EAX
  CALL @dispi
  MOV $3,%EBX
  MOV $8,%EAX
  CALL @dispi
  MOV $1,%EBX
  MOV [VBEARG],%EAX
  SHR $16,%EAX
  CALL @dispi
  MOV $2,%EBX
  MOV [VBEARG],%EAX
  AND $0xFFFF,%EAX
  CALL @dispi
  MOV $4,%EBX
  MOV $0x41,%EAX
  CALL @dispi
  MOV $0xE0000000,%EBX
  XOR %ECX,%ECX
pci_l:
  MOV %ECX,%EAX
  SHL $11,%EAX
  OR $0x80000008,%EAX
  MOV %EAX,%EDI
  MOV $0xCF8,%EDX
  OUT %EAX,%DX
  MOV $0xCFC,%EDX
  IN %DX,%EAX
  SHR $16,%EAX
  CMP $0x300,%EAX
  JNE @pci_n
  MOV %EDI,%EAX
  ADD $8,%EAX
