h_ld:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk1
  CALL @nrmA
fk1:
  MOV [G+2+EAX*8],%EBX
  JMP @st
h_st:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk2
  CALL @nrmA
fk2:
  MOV [R+EBP],%EBX
  MOV $10,%ECX
  CALL @putw
  JMP @loop
h_stw:
  MOV %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk3
  CALL @nrmA
fk3:
  MOV [R+EBP],%EBX
  MOV %EDX,%ECX
  AND $15,%ECX
  CALL @putw
  JMP @loop
h_ldn:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk4
  CALL @nrmA
fk4:
  MOV %EAX,%ECX
  CALL @nib
  MOV %EDI,%EBX
  JNC @st
  OR $-1,%EBX
  JMP @st
h_jmp:
  MOVZWL %AX,%ESI
  JMP @loop
h_call:
  MOV %ESI,[R+60]
  MOVZWL %AX,%ESI
  JMP @loop
h_ret:
  MOV [R+60],%ESI
  JMP @loop
h_jmpf:
  AND $0xFFFFFF,%EAX
  MOV %EAX,%ESI
  JMP @loop
h_callf:
  MOV %ESI,[R+60]
  AND $0xFFFFFF,%EAX
  MOV %EAX,%ESI
  JMP @loop
h_jmpr:
  MOV %ECX,%ESI
  JMP @loop
h_callr:
  MOV %ESI,[R+60]
  MOV %ECX,%ESI
  JMP @loop
h_nop:
  JMP @loop
h_vpoke:
  MOVZXB [VMODE],%EAX
  CMP $1,%EAX
  JE @vp_gfx
  CMP $2000,%ECX
  JAE @loop
  MOV [R+EBP],%EBX
  MOV %BX,[VGA+ECX*2]
  JMP @loop
vp_gfx:
  CMP [FBTOT],%ECX
  JAE @loop
  MOV [R+EBP],%EBX
  MOV [FBBASE],%EDI
  ADD %ECX,%EDI
  MOV %BL,[EDI]
  JMP @loop
h_vpeek:
  MOVZXB [VMODE],%EAX
  CMP $1,%EAX
  JE @vpk_gfx
  CMP $2000,%ECX
  JAE @loop
