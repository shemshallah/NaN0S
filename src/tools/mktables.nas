; mktables.nas - nasm0's keyword tables, generated BY NaN16 FROM the disassembler's own op table.
; Replaces tools/mktables.py (SCAFFOLD). One source of truth: disasm.nas t_ops feeds both the
; disassembler and the assembler's hash tables, so they can never disagree.
; Output (COM1/PUTC) is the text of src/prog/nasm0_tables.nas.  Hash: h=5381; h=(h<<5)+h+c.
JMP @main
.include "disasm.nas"
main:
  MOVI r13,1
  MOVI r1,59
  PUTC r1
  MOVI r1,@s_hdr
  CALL @dis_puts
  MOVI r1,@s_mnem
  CALL @dis_puts
  MOVI r1,@n_bool
  MOVI r2,0
  MOVI r3,801
  CALL @mk_line
  MOVI r5,@t_ops
  ST r5,r0,@mk_p
mk_lp:
  LD r5,r0,@mk_p
  LD r2,r5,0
  MOVI r7,4096
  CMP r2,r7
  JMP[EQ] @mk_pr
  LD r3,r5,1
  MOVI r6,2
  ADD r1,r5,r6
  CALL @mk_line
  LD r5,r0,@mk_p
  MOVI r6,4
  ADD r5,r5,r6
  ST r5,r0,@mk_p
  JMP @mk_lp
mk_pr:
  MOVI r1,@s_z3
  CALL @dis_puts
  MOVI r1,@s_preds
  CALL @dis_puts
  MOVI r5,@g_pred
  ST r5,r0,@mk_p
mk_pl:
  LD r5,r0,@mk_p
  LD r1,r5,0
  CMP r1,r0
  JMP[EQ] @mk_dr
  LD r2,r5,1
  MOVI r3,0
  CALL @mk_line2
  LD r5,r0,@mk_p
  MOVI r6,2
  ADD r5,r5,r6
  ST r5,r0,@mk_p
  JMP @mk_pl
mk_dr:
  MOVI r1,@s_z2
  CALL @dis_puts
  MOVI r1,@s_dirs
  CALL @dis_puts
  MOVI r5,@g_dirs
  ST r5,r0,@mk_p
mk_dl:
  LD r5,r0,@mk_p
  LD r1,r5,0
  CMP r1,r0
  JMP[EQ] @mk_end
  LD r2,r5,1
  MOVI r3,1
  CALL @mk_line2
  LD r5,r0,@mk_p
  MOVI r6,2
  ADD r5,r5,r6
  ST r5,r0,@mk_p
  JMP @mk_dl
mk_end:
  MOVI r1,@s_z2
  CALL @dis_puts
  HALT
mk_p:
.word 0

; mk_line: r1=2-word name ptr, r2=op, r3=form  ->  .word HASH,OP,FORM   ; NAME forms
mk_line:
  ST r15,r0,@ml_lnk
  ST r1,r0,@ml_name
  ST r2,r0,@ml_op
  ST r3,r0,@ml_form
  MOVI r1,@s_word
  CALL @dis_puts
  LD r1,r0,@ml_name
  CALL @mk_hash
  CALL @dis_dec
  MOVI r1,44
  PUTC r1
  LD r1,r0,@ml_op
  CALL @dis_dec
  MOVI r1,44
  PUTC r1
  LD r1,r0,@ml_form
  CALL @dis_dec
  CALL @mk_cmt
  LD r1,r0,@ml_name
  CALL @dis_putn
  CALL @dis_putsp
  LD r1,r0,@ml_form
  CALL @mk_formstr
  MOVI r1,10
  PUTC r1
  LD r15,r0,@ml_lnk
  RET
ml_lnk:
.word 0
ml_name:
.word 0
ml_op:
.word 0
ml_form:
.word 0

; mk_line2: r1=NUL-terminated name ptr, r2=value, r3=1 to print a leading '.' in the comment
mk_line2:
  ST r15,r0,@m2_lnk
  ST r1,r0,@ml_name
  ST r2,r0,@ml_op
  ST r3,r0,@ml_form
  MOVI r1,@s_word
  CALL @dis_puts
  LD r1,r0,@ml_name
  CALL @mk_hash
  CALL @dis_dec
  MOVI r1,44
  PUTC r1
  LD r1,r0,@ml_op
  CALL @dis_dec
  CALL @mk_cmt
  LD r1,r0,@ml_form
  CMP r1,r0
  JMP[EQ] @m2_nd
  MOVI r1,46
  PUTC r1
m2_nd:
  LD r1,r0,@ml_name
  CALL @dis_puts
  MOVI r1,10
  PUTC r1
  LD r15,r0,@m2_lnk
  RET
m2_lnk:
.word 0

; mk_hash: r1=name ptr (stops at space/NUL) -> r1=djb2-style hash, leaf
mk_hash:
  MOVI r8,5381
  MOVI r4,255
  MOVI r6,32
mh_w:
  LD r2,r1,0
  MOVI r3,4
mh_c:
  BOOL.8 r5,r2,r4
  CMP r5,r6
  JMP[EQ] @mh_e
  CMP r5,r0
  JMP[EQ] @mh_e
  SHL r7,r8,5
  ADD r8,r7,r8
  ADD r8,r8,r5
  SHR r2,r2,8
  SUB r3,r3,r13
  JMP[NE] @mh_c
  ADD r1,r1,r13
  JMP @mh_w
mh_e:
  ADD r1,r8,r0
  RET

; mk_formstr: form nibbles (low first) -> letters d a b i j
mk_formstr:
  MOVI r4,15
mf_l:
  CMP r1,r0
  RET[EQ]
  BOOL.8 r2,r1,r4
  SHR r1,r1,4
  LD r3,r2,@t_fl
  PUTC r3
  JMP @mf_l
t_fl:
.word 63,100,97,98,105,106

s_hdr:
.str " GENERATED by src/tools/mktables.nas (NaN16) - do not edit. hash h=(h<<5)+h+c from 5381, entries end with hash 0.\n"
s_mnem:
.str "mnem:\n"
s_preds:
.str "preds:\n"
s_dirs:
.str "dirs:\n"
s_word:
.str ".word "
s_z3:
.str ".word 0,0,0\n"
s_z2:
.str ".word 0,0\n"
n_bool:
.str "BOOL   "
a_always:
.str "ALWAYS"
d_word:
.str "word"
d_str:
.str "str"
d_equ:
.str "equ"
g_pred:
.word @a_always,15,@p_never,0,@p_eq,4,@p_ne,3,@p_lt,2,@p_ge,5,@p_gt,1,@p_le,6,0,0
g_dirs:
.word @d_word,1,@d_str,2,@d_equ,3,0,0
; mk_cmt: prints "   ; " (leaf; the ';' is PUTC because the scaffold's line cutter splits strings at ';')
mk_cmt:
  MOVI r1,32
  PUTC r1
  PUTC r1
  PUTC r1
  MOVI r1,59
  PUTC r1
  MOVI r1,32
  PUTC r1
  RET
